// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "agent": {
    "dock": "right",
    "default_profile": "ask",
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-6-latest",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "provider": "zed",
  },
  "window_decorations": "server",
  "title_bar": {
    "show_branch_icon": true,
    "show_menus": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_sign_in": true,
    "show_user_menu": true,
    "show_user_picture": true,
  },
  "tabs": {
    "activate_on_close": "history",
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "use_system_window_tabs": true,
  "preview_tabs": {
    "enabled": false,
  },
  "terminal": {
    "dock": "right",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "agent_servers": {
    "gemini": {
      "default_model": "auto-gemini-3",
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
      "default_model": "sonnet",
      "favorite_models": ["default"],
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "/opt/homebrew/bin/claude",
      },
    },
  },
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Min Light (Blurred)",
    "dark": "Min Dark (Blurred)",
  },
  "file_types": {
    "YAML": ["*.yml.j2", "*.yaml.j2"],
    "Ansible": [
      "**.ansible.yml",
      "**.ansible.yaml",
      "**/defaults/*.yml",
      "**/defaults/*.yaml",
      "**/meta/*.yml",
      "**/meta/*.yaml",
      "**/tasks/*.yml",
      "**/tasks/*.yaml",
      "**/handlers/*.yml",
      "**/handlers/*.yaml",
      "**/group_vars/*.yml",
      "**/group_vars/*.yaml",
      "**/playbooks/*.yaml",
      "**/playbooks/*.yml",
      "**playbook*.yaml",
      "**playbook*.yml",
    ],
  },
}
